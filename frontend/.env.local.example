NEXTAUTH_URL=http://localhost:3000
# NextAuth's own session key — frontend-only, the backend never reads it.
NEXTAUTH_SECRET=test-secret-at-least-32-chars-long-for-e2e

# Must be byte-identical to BACKEND_JWT_SECRET in backend/.env, or the token
# /api/backend-token mints fails signature verification and every backend call
# 401s while the UI otherwise looks fine. Both files ship the same throwaway
# value so a fresh clone just works; regenerate both together for anything
# shared:  openssl rand -hex 32
BACKEND_JWT_SECRET=dummy-secret

GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
