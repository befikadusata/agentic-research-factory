# App environment: development | production
# In production mode, missing TAVILY_API_KEY / FIRECRAWL_API_KEY / LLAMA_CLOUD_API_KEY causes a hard startup failure.
ENVIRONMENT=development

# LLM
# Legacy single-provider mode. If set, this overrides per-agent routing.
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Routed provider keys. Leave unused providers blank; placeholder strings are
# treated as real credentials.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional per-agent model overrides. Leave blank to use capability-based
# routing across whichever provider keys are configured above.
STRATEGIST_MODEL=
RESEARCHER_MODEL=
LEAD_INTEL_MODEL=
QUERY_REWRITER_MODEL=
ANALYST_MODEL=
WRITER_MODEL=
EDITOR_MODEL=
REVIEWER_MODEL=
EVAL_MODEL=
# Optional: pin the quality judges (reviewer + eval-confidence) to a model
# distinct from the generators they grade, so a model doesn't grade its own
# output. Applies even in legacy (LLM_MODEL) mode; a second model on the same
# provider is enough. Unset → judges follow the normal per-agent resolution.
JUDGE_MODEL=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=384

# Search & Scraping
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Self-hosted alternatives to Tavily/Firecrawl (see docker-compose.yml:
# searxng, firecrawl-api). If set, these take priority over the cloud
# keys above — no payment method or geo-available account required.
# When running via `docker compose up`, these are overridden to the
# in-network service names automatically.
SEARXNG_URL=http://localhost:8081
FIRECRAWL_API_URL=http://localhost:3002
# FIRECRAWL_API_KEY above can be any placeholder string in this mode —
# the self-hosted API doesn't check it (USE_DB_AUTHENTICATION=false).

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/research_factory
REDIS_URL=redis://localhost:6379/0

# App
BACKEND_JWT_SECRET=generate-with-openssl-rand-hex-32
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# PDF Parsing
LLAMA_CLOUD_API_KEY=

# Optional — leave blank for V1
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Vector store for uploaded-document RAG. Defaults to DATABASE_URL with the
# async driver stripped (vecs uses psycopg2), so the pgvector database Compose
# already runs serves it and no configuration is needed. Set this only to point
# the embeddings at a different Postgres — it must have the vector extension.
# VECTOR_DB_URL=postgresql://user:password@localhost:5434/research_factory
